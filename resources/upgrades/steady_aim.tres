[gd_resource type="Resource" script_class="UpgradeData" format=3]

[ext_resource type="Script" path="res://scripts/data/upgrade_data.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/data/stat_modifier.gd" id="2_mod"]
[ext_resource type="Texture2D" path="res://assets/floor38/ui/upgrade_icons.png" id="3_icons"]

[sub_resource type="AtlasTexture" id="icon"]
atlas = ExtResource("3_icons")
region = Rect2(208, 0, 16, 16)

[sub_resource type="Resource" id="mod_1"]
script = ExtResource("2_mod")
stat = 7
value = -0.4

[sub_resource type="Resource" id="mod_2"]
script = ExtResource("2_mod")
stat = 4

[resource]
script = ExtResource("1_script")
id = &"steady_aim"
title = "Steady Aim"
description = "[color=#a7f070]-40%[/color] bullet spread
[color=#a7f070]+10%[/color] projectile speed"
icon = SubResource("icon")
modifiers = Array[ExtResource("2_mod")]([SubResource("mod_1"), SubResource("mod_2")])
max_stacks = 3
styles = Array[StringName]([&"gun"])
